<section class='tab items {{tab.cssClass}}' data-group='primary' data-tab='gear'>
	<div class='gear-cash-row'>
		<label for='system.general.cash' class='resource-label abilities-name'>{{toUpperCase (localize 'TALESOFTHEOLDWEST.General.cash')}}</label>
		<input class='currency' name='system.general.cash' value='{{system.general.cash}}' data-dtype='String' type='text' />

		<label for='system.general.capital' class='resource-label abilities-name'>{{toUpperCase (localize 'TALESOFTHEOLDWEST.General.capital')}}</label>
		<input class='currency' name='system.general.capital' value='{{system.general.capital}}' data-dtype='String' type='text' />
	</div>
	<div class='gear-list-full'>
		{{>"systems/talesoftheoldwest/templates/actor/parts/actor-gear-list.hbs"}}
	</div>
	<div style="margin-left:15px; margin-top:5px;border-top: black solid;">{{>"systems/talesoftheoldwest/templates/actor/parts/actor-horse.hbs"}}</div>

</section>
